// X-macro: REG(name, byte_offset, bit_width)
// byte_offset is the position in the IGNIL register address space.
// Sub-registers share the base offset of their parent; width selects the slice.
//
// AArch64 layout (one slot = 8 bytes unless noted):
//   X0..X28  X29(FP)  X30(LR)  XZR  SP   PC
//     0..224    232      240    248  256  264
//
//   V0..V31  (16 bytes / 128-bit each)
//     272..768
//
//   NF ZF CF VF  (NZCV, 1 byte each)
//   784 785 786 787

// ---------------------------------------------------------------------------
// 64-bit general-purpose registers
// ---------------------------------------------------------------------------

REG("X0",  0,   64)
REG("X1",  8,   64)
REG("X2",  16,  64)
REG("X3",  24,  64)
REG("X4",  32,  64)
REG("X5",  40,  64)
REG("X6",  48,  64)
REG("X7",  56,  64)
REG("X8",  64,  64)
REG("X9",  72,  64)
REG("X10", 80,  64)
REG("X11", 88,  64)
REG("X12", 96,  64)
REG("X13", 104, 64)
REG("X14", 112, 64)
REG("X15", 120, 64)
REG("X16", 128, 64)
REG("X17", 136, 64)
REG("X18", 144, 64)
REG("X19", 152, 64)
REG("X20", 160, 64)
REG("X21", 168, 64)
REG("X22", 176, 64)
REG("X23", 184, 64)
REG("X24", 192, 64)
REG("X25", 200, 64)
REG("X26", 208, 64)
REG("X27", 216, 64)
REG("X28", 224, 64)
REG("X29", 232, 64) // frame pointer (FP)
REG("X30", 240, 64) // link register (LR)
REG("XZR", 248, 64) // zero register
REG("SP",  256, 64) // stack pointer
REG("PC",  264, 64) // program counter

// Aliases - same offset as X29/X30
REG("FP",  232, 64)
REG("LR",  240, 64)

// ---------------------------------------------------------------------------
// 32-bit general-purpose registers (lower half of each X register)
// ---------------------------------------------------------------------------

REG("W0",  0,   32)
REG("W1",  8,   32)
REG("W2",  16,  32)
REG("W3",  24,  32)
REG("W4",  32,  32)
REG("W5",  40,  32)
REG("W6",  48,  32)
REG("W7",  56,  32)
REG("W8",  64,  32)
REG("W9",  72,  32)
REG("W10", 80,  32)
REG("W11", 88,  32)
REG("W12", 96,  32)
REG("W13", 104, 32)
REG("W14", 112, 32)
REG("W15", 120, 32)
REG("W16", 128, 32)
REG("W17", 136, 32)
REG("W18", 144, 32)
REG("W19", 152, 32)
REG("W20", 160, 32)
REG("W21", 168, 32)
REG("W22", 176, 32)
REG("W23", 184, 32)
REG("W24", 192, 32)
REG("W25", 200, 32)
REG("W26", 208, 32)
REG("W27", 216, 32)
REG("W28", 224, 32)
REG("W29", 232, 32)
REG("W30", 240, 32)
REG("WZR", 248, 32) // zero register (32-bit view)
REG("WSP", 256, 32) // stack pointer (32-bit view)

// ---------------------------------------------------------------------------
// NEON/FP vector registers - 128-bit (V / Q)
// Each register occupies 16 bytes; sub-registers share the base offset.
// ---------------------------------------------------------------------------

REG("V0",  272, 128)
REG("V1",  288, 128)
REG("V2",  304, 128)
REG("V3",  320, 128)
REG("V4",  336, 128)
REG("V5",  352, 128)
REG("V6",  368, 128)
REG("V7",  384, 128)
REG("V8",  400, 128)
REG("V9",  416, 128)
REG("V10", 432, 128)
REG("V11", 448, 128)
REG("V12", 464, 128)
REG("V13", 480, 128)
REG("V14", 496, 128)
REG("V15", 512, 128)
REG("V16", 528, 128)
REG("V17", 544, 128)
REG("V18", 560, 128)
REG("V19", 576, 128)
REG("V20", 592, 128)
REG("V21", 608, 128)
REG("V22", 624, 128)
REG("V23", 640, 128)
REG("V24", 656, 128)
REG("V25", 672, 128)
REG("V26", 688, 128)
REG("V27", 704, 128)
REG("V28", 720, 128)
REG("V29", 736, 128)
REG("V30", 752, 128)
REG("V31", 768, 128)

// Q registers - 128-bit alias for V (same offsets)
REG("Q0",  272, 128)
REG("Q1",  288, 128)
REG("Q2",  304, 128)
REG("Q3",  320, 128)
REG("Q4",  336, 128)
REG("Q5",  352, 128)
REG("Q6",  368, 128)
