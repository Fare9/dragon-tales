// ---------------------------------------------------------------------------
// NZCV condition flags (1 byte slot each, 1-bit semantics)
// "VF" avoids collision with the V register prefix
// ---------------------------------------------------------------------------

REG("NF", 784, 8) // Negative
REG("ZF", 785, 8) // Zero
REG("CF", 786, 8) // Carry
REG("VF", 787, 8) // Overflow
