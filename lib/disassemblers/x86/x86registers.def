// X-macro: REG(name, byte_offset, bit_width)
// byte_offset is the position in the IGNIL register address space.
// Sub-registers share the base offset of their parent; width selects the slice.

// 64-bit
REG("RAX",  0,   64)
REG("RCX",  8,   64)
REG("RDX",  16,  64)
REG("RBX",  24,  64)
REG("RSP",  32,  64)
REG("RBP",  40,  64)
REG("RSI",  48,  64)
REG("RDI",  56,  64)
REG("R8",   64,  64)
REG("R9",   72,  64)
REG("R10",  80,  64)
REG("R11",  88,  64)
REG("R12",  96,  64)
REG("R13",  104, 64)
REG("R14",  112, 64)
REG("R15",  120, 64)
REG("RIP",  128, 64)

// 32-bit (same base offset as 64-bit parent)
REG("EAX",  0,   32)
REG("ECX",  8,   32)
REG("EDX",  16,  32)
REG("EBX",  24,  32)
REG("ESP",  32,  32)
REG("EBP",  40,  32)
REG("ESI",  48,  32)
REG("EDI",  56,  32)
REG("R8D",  64,  32)
REG("R9D",  72,  32)
REG("R10D", 80,  32)
REG("R11D", 88,  32)
REG("R12D", 96,  32)
REG("R13D", 104, 32)
REG("R14D", 112, 32)
REG("R15D", 120, 32)

// 16-bit
REG("AX",   0,   16)
REG("CX",   8,   16)
REG("DX",   16,  16)
REG("BX",   24,  16)
REG("SP",   32,  16)
REG("BP",   40,  16)
REG("SI",   48,  16)
REG("DI",   56,  16)

// 8-bit low
REG("AL",   0,   8)
REG("CL",   8,   8)
REG("DL",   16,  8)
REG("BL",   24,  8)
REG("SPL",  32,  8)
REG("BPL",  40,  8)
REG("SIL",  48,  8)
REG("DIL",  56,  8)

// 8-bit high (byte 1 of the 16-bit view: AH = bits [15:8] of AX)
REG("AH",   1,   8)
REG("CH",   9,   8)
REG("DH",   17,  8)
REG("BH",   25,  8)

// Flags - 1-byte slots, 1-bit semantics; offsets start at 136
REG("CF",   136, 8)
REG("PF",   137, 8)
REG("AF",   138, 8)
REG("ZF",   139, 8)
REG("SF",   140, 8)
REG("OF",   141, 8)
REG("DF",   142, 8)
